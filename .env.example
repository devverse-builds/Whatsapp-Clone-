# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_clone

# JWT Secrets (replace with cryptographically strong secrets in production)
JWT_ACCESS_SECRET=wac_access_secret_super_secure_random_key_2026_9876543210
JWT_REFRESH_SECRET=wac_refresh_secret_super_secure_random_key_2026_1234567890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Storage Configuration (local or cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WebRTC STUN/TURN Configuration (comma-separated STUN URLs)
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]
