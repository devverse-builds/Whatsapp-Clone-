{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/socket.io/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/css/(.*)", "destination": "/client/css/$1" },
    { "source": "/js/(.*)", "destination": "/client/js/$1" },
    { "source": "/client/(.*)", "destination": "/client/$1" },
    { "source": "/", "destination": "/client/index.html" },
    { "source": "/((?!api|uploads|socket.io|css|js|client).*)", "destination": "/client/index.html" }
  ]
}
